# Exemplo de variáveis de ambiente para o Mestre do PC V10.
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite .env.local.

# === Ponte NEXO (sessão de funções nexo_*) ===
# Caminho da pasta do nexo-core (onde fica o nexo.mjs). Se vazio, a ponte tenta
# localizar um ../nexo-core irmão; se não achar, o Mestre roda sem as tools nexo_*.
NEXO_HOME=C:\Users\JEANPC\nexo-core
NEXO_ENABLED=1
# NEXO_TOOL_PREFIX=nexo_
# NEXO_START_TIMEOUT_MS=15000
# NEXO_CALL_TIMEOUT_MS=120000

# === Ponte Chrome DevTools (sessão de funções chrome_*) ===
# Debugging de browser pelo Chrome DevTools Protocol: list_pages, new_page,
# navigate_page, take_snapshot, evaluate_script, take_screenshot, click, fill,
# list_console_messages, list_network_requests, lighthouse_audit,
# performance_start_trace. O pacote é resolvido em mcp-server/node_modules.
# Instale com o comando "Instalar Chrome DevTools MCP" (UI) ou:
#   cd mcp-server && npm install chrome-devtools-mcp@1.12.0
CHROME_DEVTOOLS_ENABLED=1
# CHROME_DEVTOOLS_TOOL_PREFIX=chrome_
# 1 = Chrome headless (não abre janela). 0 = abre o Chrome visível.
CHROME_DEVTOOLS_HEADLESS=1
# Pastas extras autorizadas para o browser gravar arquivos (screenshots,
# traces). Separe por ";". A raiz do projeto e a pasta temporária do SO já
# são liberadas automaticamente.
# CHROME_DEVTOOLS_WORKSPACE=C:\Users\JEANPC\Mestre-do-PC-V10\logs
# Caminho explícito do executável do Chrome (opcional).
# CHROME_DEVTOOLS_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROME_DEVTOOLS_START_TIMEOUT_MS=30000
# CHROME_DEVTOOLS_CALL_TIMEOUT_MS=120000

# === Launcher / Projeto ===
MESTRE_BASE_URL=http://127.0.0.1:7777
MESTRE_PROJETO_PATH=C:\Users\JEANPC\Mestre-do-PC-V10
MESTRE_AUDIT_LOG_DIR=logs/audit
MESTRE_EXTENSION_TOKEN=
MESTRE_EXTENSION_ORIGINS=
MESTRE_NPP_TOKEN=
MESTRE_MODO_LIVRE=0

# === MCP Local (autenticação do cliente MCP no launcher + tools de banco) ===
# OBRIGATÓRIO (fail-closed). O launcher só aceita o cliente "mcp" que enviar
# este token (header X-Mestre-Mcp-Token) — o MCP server e o chat integrado
# enviam automaticamente. Se ficar vazio, o launcher GERA um token na primeira
# inicialização e grava aqui no .env.local; reinicie o MCP server depois disso.
# Use o MESMO valor no launcher e no MCP server (ambos leem este .env.local).
# Para gerar manualmente: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MESTRE_LOCAL_MCP_TOKEN=
# Emergência apenas: 1 = volta ao modo legado (cliente "mcp" sem token). Inseguro.
MESTRE_ALLOW_LEGACY_MCP=0

# === Banco de dados MySQL / MariaDB ===
# Modo local (XAMPP, WAMP, MySQL Installer, MariaDB local):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=senha_local
MYSQL_DATABASE=mestre_pc
MYSQL_SSL=0
# MYSQL_SOCKET_PATH=/var/run/mysqld/mysqld.sock

# Modo remoto (ex: Hostinger):
# MYSQL_HOST=seu-host.hostinger.com
# MYSQL_PORT=3306
# MYSQL_USER=u123456789_mestre
# MYSQL_PASSWORD=senha_forte
# MYSQL_DATABASE=u123456789_mestre_pc
# MYSQL_SSL=1
# MYSQL_SSL_REJECT_UNAUTHORIZED=0

# === Ollama ===
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_MODEL_PROFILE=
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_NUM_PREDICT=0
OLLAMA_SEED=0
OLLAMA_KEEP_ALIVE=5m
