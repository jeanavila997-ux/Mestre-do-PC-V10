# Exemplo de variáveis de ambiente para o Mestre do PC V10.
# Copie este arquivo para .env.local e preencha com seus valores reais.
# NUNCA commite .env.local.

# === Launcher / Projeto ===
MESTRE_BASE_URL=http://127.0.0.1:7777
MESTRE_PROJETO_PATH=C:\Users\JEANPC\Mestre-do-PC-V10
MESTRE_AUDIT_LOG_DIR=logs/audit
MESTRE_EXTENSION_TOKEN=
MESTRE_EXTENSION_ORIGINS=
MESTRE_NPP_TOKEN=
MESTRE_MODO_LIVRE=0

# === MCP Local (autenticação dos tools de banco) ===
# Gere um token seguro com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MESTRE_LOCAL_MCP_TOKEN=

# === Banco de dados MySQL / MariaDB ===
# Modo local (XAMPP, WAMP, MySQL Installer, MariaDB local):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=senha_local
MYSQL_DATABASE=mestre_pc
MYSQL_SSL=0
# MYSQL_SOCKET_PATH=/var/run/mysqld/mysqld.sock

# Modo remoto (ex: Hostinger):
# MYSQL_HOST=seu-host.hostinger.com
# MYSQL_PORT=3306
# MYSQL_USER=u123456789_mestre
# MYSQL_PASSWORD=senha_forte
# MYSQL_DATABASE=u123456789_mestre_pc
# MYSQL_SSL=1
# MYSQL_SSL_REJECT_UNAUTHORIZED=0

# === Ollama ===
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_API_KEY=
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_MODEL_PROFILE=
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_NUM_PREDICT=0
OLLAMA_SEED=0
OLLAMA_KEEP_ALIVE=5m
