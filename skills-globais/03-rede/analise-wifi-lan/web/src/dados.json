  "comandos": [
    {
      "id": "ping-mestre",
      "titulo": "Health do launcher Mestre",
      "shell": "pwsh",
      "codigo": "Invoke-RestMethod http://127.0.0.1:7777/ping"
    },
    {
      "id": "wifi-iface",
      "titulo": "Interface Wi-Fi atual",
      "shell": "pwsh",
      "codigo": "netsh wlan show interfaces"
    },
    {
      "id": "wifi-scan",
      "titulo": "Redes próximas (BSSID)",
      "shell": "pwsh",
      "codigo": "netsh wlan show networks mode=bssid"
    },
    {
      "id": "arp",
      "titulo": "Dispositivos conhecidos (ARP)",
      "shell": "pwsh",
      "codigo": "arp -a\n# ou MCP: mestre_do_pc__seg_arp"
    },
    {
      "id": "ipconfig",
      "titulo": "IP / gateway / DNS",
      "shell": "pwsh",
      "codigo": "Get-NetIPConfiguration -InterfaceAlias 'Wi-Fi'\nGet-DnsClientServerAddress -InterfaceAlias 'Wi-Fi' -AddressFamily IPv4"
    },
    {
      "id": "latencia",
      "titulo": "Latência gateway + DNS públicos",
      "shell": "pwsh",
      "codigo": "Test-Connection 192.168.1.1,1.1.1.1,8.8.8.8 -Count 4"
    },
    {
      "id": "speed-cf",
      "titulo": "Speed test Cloudflare (download)",
      "shell": "pwsh",
      "codigo": "$sw=[Diagnostics.Stopwatch]::StartNew()\nInvoke-WebRequest 'https://speed.cloudflare.com/__down?bytes=25000000' -OutFile $env:TEMP\\cf.bin\n$sw.Stop(); $b=(Get-Item $env:TEMP\\cf.bin).Length\n[math]::Round(($b*8)/$sw.Elapsed.TotalSeconds/1e6,1)  # Mbps"
    },
    {
      "id": "isp",
      "titulo": "IP público / ISP",
      "shell": "pwsh",
      "codigo": "Invoke-RestMethod https://ipinfo.io/json"
    },
    {
      "id": "users",
      "titulo": "Usuário logado + contas locais",
      "shell": "pwsh",
      "codigo": "Get-CimInstance Win32_ComputerSystem | Select UserName,Name,Domain\nGet-LocalUser | Select Name,Enabled,LastLogon"
    },
    {
      "id": "analise-script",
      "titulo": "Script completo desta pasta",
      "shell": "pwsh",
      "codigo": "pwsh -NoProfile -File .\\analisar-rede-mestre.ps1"
    }
  ]
}
